<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Steamworks.NET" HintPath="$(Sts2DataDir)/Steamworks.NET.dll" />
    <None Include="$(Sts2DataDir)/steam_api64.dll" Link="steam_api64.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireSteamClientLibraries" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(Sts2DataDir)/Steamworks.NET.dll') or !Exists('$(Sts2DataDir)/steam_api64.dll')"
           Text="Pass -p:Sts2DataDir pointing to the installed Windows x64 game's data directory." />
  </Target>
</Project>

<Project Sdk="Godot.NET.Sdk/4.5.1">
  <Import Project="..\..\eng\NinjaSlayer.Dependencies.props" />
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CandidateRoot Condition="'$(CandidateRoot)' != ''">$([System.IO.Path]::GetFullPath('$(CandidateRoot)'))</CandidateRoot>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="NinjaSlayerHostChannel" Value="$(NinjaSlayerHostChannel)" />
    <AssemblyMetadata Include="NinjaSlayerGameApiVersion" Value="$(NinjaSlayerGameApiVersion)" />
    <AssemblyMetadata Include="NinjaSlayerRitsuLibPackageId" Value="$(NinjaSlayerRitsuLibPackageId)" />
    <AssemblyMetadata Include="NinjaSlayerRitsuLibVersion" Value="$(NinjaSlayerRitsuLibVersion)" />
    <AssemblyMetadata Include="NinjaSlayerSourceRevision" Value="$(NinjaSlayerSourceRevision)" />
  </ItemGroup>
  <Target Name="ValidateTrustedInputs" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(NinjaSlayerHostChannelWasExplicit)' != 'true'"
           Text="The private contract requires an explicit NinjaSlayerHostChannel=stable|preview." />
    <Error Condition="'$(NinjaSlayerRitsuLibPackageId)' == ''"
           Text="NinjaSlayerRitsuLibPackageId was not resolved for channel '$(NinjaSlayerHostChannel)'." />
    <Error Condition="'$(CandidateRoot)' == ''"
           Text="CandidateRoot is required and must point to a checked-out NinjaSlayer repository." />
    <Error Condition="'$(CandidateRoot)' != '' and !Exists('$(CandidateRoot)/NinjaSlayer.csproj')"
           Text="CandidateRoot '$(CandidateRoot)' does not contain NinjaSlayer.csproj." />
    <Error Condition="'$(NinjaSlayerSourceRevision)' == ''"
           Text="NinjaSlayerSourceRevision is required and must be the candidate's full 40-character SHA." />
    <Error Condition="'$(NinjaSlayerSourceRevision)' != '' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(NinjaSlayerSourceRevision)', '^[0-9a-fA-F]{40}$')) != 'true'"
           Text="NinjaSlayerSourceRevision must be the candidate's full 40-character SHA." />
    <Error Condition="!Exists('$(Sts2DataDir)/sts2.dll') or !Exists('$(Sts2DataDir)/0Harmony.dll')"
           Text="The private contract requires sts2.dll and 0Harmony.dll." />
  </Target>
  <ItemGroup Condition="'$(CandidateRoot)' != ''">
    <Compile Include="$(CandidateRoot)\Afflictions\**\*.cs" />
    <Compile Include="$(CandidateRoot)\Ancients\**\*.cs" />
    <Compile Include="$(CandidateRoot)\Cards\**\*.cs" />
    <Compile Include="$(CandidateRoot)\Code\**\*.cs" />
    <Compile Include="$(CandidateRoot)\Content\**\*.cs" />
    <Compile Include="$(CandidateRoot)\Enchantments\**\*.cs" />
    <Compile Include="$(CandidateRoot)\Encounters\**\*.cs" />
    <Compile Include="$(CandidateRoot)\Events\**\*.cs" />
    <Compile Include="$(CandidateRoot)\Monsters\**\*.cs" />
    <Compile Include="$(CandidateRoot)\Potions\**\*.cs" />
    <Compile Include="$(CandidateRoot)\Powers\**\*.cs" />
    <Compile Include="$(CandidateRoot)\Relics\**\*.cs" />
    <Compile Include="$(CandidateRoot)\Scripts\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="$(NinjaSlayerRitsuLibPackageId)" Version="$(NinjaSlayerRitsuLibVersion)" PrivateAssets="all" />
    <PackageReference Include="SmartFormat" Version="$(NinjaSlayerSmartFormatVersion)" />
  </ItemGroup>
</Project>

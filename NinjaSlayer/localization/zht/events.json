  "NINJA_SLAYER_EVENT_NARAKU_EVENT.pages.INITIAL.options.ACCEPT_NARAKU.title": "接受奈落",
  "NINJA_SLAYER_EVENT_NARAKU_EVENT.pages.INITIAL.options.ACCEPT_NARAKU.description": "獲得[gold]奈落解放[/gold]。",

{
  "NINJA_SLAYER_EVENT_NANCY_LEE.title": "Nancy Lee",
  "NINJA_SLAYER_EVENT_NANCY_LEE.epithet": "Alte Verbündete",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.firstVisitEver.0-0.ancient": "Drei Minuten und vierzig Sekunden zu spät, Ninja Slayer-san.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.firstVisitEver.0-0.next": "Antworten",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.firstVisitEver.0-1.char": "Unterwegs waren Ninja.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.firstVisitEver.0-1.next": "Ausrüstung wählen",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.firstVisitEver.0-2.ancient": "Dachte ich mir. Diese Verbindung schafft einen Gegenstand. Such dir einen aus.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.0-0r.ancient": "Diese Verbindung hält noch neunzig Sekunden. Du bekommst sechzig.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.0-0r.next": "Verstanden",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.0-1r.char": "Und die anderen dreißig?",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.0-1r.next": "Ausrüstung wählen",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.0-2r.ancient": "Damit ich rauskomme. Wähle.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.1-0r.ancient": "Ein Lebenszeichen im Gang rechts von dir.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.1-0r.next": "Weitergehen",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.1-1r.char": "Ein Ninja.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.1-1r.next": "Ausrüstung wählen",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.1-2r.ancient": "Natürlich. Deine Ausrüstung ist in Reichweite.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.pages.DONE.description": "",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "[sine]...ein... Körper.... zwei... Stimmen.... was... bist du...?[/sine]",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Begrüßen",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Domo, Neow-san. Ninja Slayer desu. Bist du ein Ninja?",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Fortfahren",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "[sine]...nein.... oben... sind... Ninja.... geh....[/sine]",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "[sine]...ich habe dich... wieder zurückgebracht.... erwache.... steige....[/sine]",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "[sine]...du... hast ihn getötet.... er lebt... wieder....[/sine]",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Antworten",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Dann töte ich ihn erneut.",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Annehmen",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "[sine]...geh....[/sine]",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.char": "Domo, Darv-san. Ninja Slayer desu.",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Begrüßen",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.ancient": "Furchterregender Name, reizende Manieren! Rot-schwarzer Freund, in diesem Haufen habe ich etwas für dich!",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Wählen",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.char": "Es genügt, wenn es Ninja tötet.",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "Das letzte schon kaputt? Nimm ein neues! Wirf es nur nicht nach mir!",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "Du bist zurück! Wo ist das letzte, das ich dir gegeben habe?",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Antworten",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Ich erinnere mich nicht, etwas von dir genommen zu haben.",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Wählen",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "Hä? Dann das erste Mal! Such dir etwas aus!",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "Rot und Schwarz. Gewagt, aber grob. Komm, Assassine. Lass mich deine Kleidung retten.",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Antworten",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Sie darf mein Karate nicht behindern.",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Annehmen",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "Natürlich. Wahre Pracht weicht niemals der Stärke.",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "Mein rot-schwarzer Krieger. Endlich kehrst du zu meinem guten Geschmack zurück.",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "Noch immer dieses Gewand. Ärgerlich stur. Wenigstens treu.",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Antworten",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Es genügt.",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Annehmen",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "„Genügend“ ist für Mittelmäßige. Komm, mein Krieger.",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "Rot und Schwarz! Blutdurst! Zwei Stimmen?! Warum? Wer ist da noch drin?!",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Antworten",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Antworte mir zuerst. Bist du ein Ninja?",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Nehmen",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "Nein! Kein Kampf! Nimm etwas Glänzendes und beruhige dich!!",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "Schon wieder da?! Noch immer zwei Stimmen! Und alle Arme! Gut! Nimm etwas, kein Kampf!!",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "Noch immer so wütend! Warum jedes Mal dieser Blutdurst?!",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Antworten",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Oben sind noch Ninja.",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Nehmen",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "Hier nicht! Das hier glänzt am meisten. Nimm es und geh!!",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "[thinky_dots]So müde... doch dein Zorn schläft nicht.[/thinky_dots]",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Antworten",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Keine Ruhe, bevor meine Aufgabe erfüllt ist.",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Geschenk annehmen",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "[thinky_dots]Dann lass mein Fleisch ein wenig davon tragen...[/thinky_dots]",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "[i][font_size=22]Pael liegt zusammengerollt und reglos da. Ein langes Schnarchen hallt durch den Raum.[/font_size][/i]",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "[thinky_dots]Bei jedem Besuch... dieselben zwei Namen in deinem Herzen...[/thinky_dots]",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Antworten",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Sprich sie nicht aus.",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Geschenk annehmen",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "[thinky_dots]Das werde ich nicht... nimm einen Teil von mir und geh weiter...[/thinky_dots]",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "[b]Rot-schwarzer Krieger! Wo ist deine Waffe!?[/b]",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Antworten",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Antworte mir zuerst. Bist du ein Ninja?",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Waffe wählen",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "[b]Nein! Ich bin der Chimärenkönig!! Nimm eine Waffe und kämpfe gegen mich!![/b]",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "[b]Ninja Slayer! Wieder zurück!! Zeig mir dein Karate!![/b]",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "[b]Ninja Slayer! Kämpfe gegen mich!![/b]",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Kämpfen",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "[i][font_size=22]Ninja Slayer tauscht Schläge mit Tanx aus.[/font_size][/i]",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Waffe wählen",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "[b]Vortreffliches Karate!! Nimm eine Waffe! Wir kämpfen wieder!![/b]",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "Oh, Liebling. Dieses Feuer beißt dich ständig. Soll ich ihm Manieren beibringen?",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Warnen",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Fass es nicht an.",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Annehmen",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "So ein [jitter][b]egoistisches[/b][/jitter] Kind. Dann kümmere ich mich zuerst um dich.",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "Willkommen zurück, Liebling. Welchen Makel brennen wir heute weg?",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "Der Architekt lebt noch? Wie unhöflich, einen Gast warten zu lassen.",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Antworten",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Nicht mehr lange.",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Annehmen",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "Dann iss auf, bevor du gehst, Liebling.",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "Dein Gast ist wach. Lass ihn ebenfalls meine Bedingungen hören.",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Warnen",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Rufe ihn nicht. Bist du ein Ninja?",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Vertrag lesen",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "Nein. Ich weiß lediglich, wie man eine willige Vertragspartei findet.",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "Letztes Mal hast du im Namen dieses Körpers abgelehnt. Wirst du es wieder tun?",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "Ich kann diese Stimme für immer zum Schweigen bringen. Als Bezahlung nur dieser Körper.",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Ablehnen",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Dieser Körper gehört dir nicht.",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Vertrag lesen",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "Vielleicht gehört er auch nicht dir allein. Für solche Streitfälle gibt es Verträge.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0r.ancient": "Kehre zum Fuß des Turms zurück.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0r.next": "Ablehnen",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1r.char": "Ich lehne ab.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "Unmöglich. Du wurdest zum Fuß zurückgeschickt.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.next": "Antworten",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-1r.char": "Und doch stehe ich hier.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0r.ancient": "Neow hat dich zurückgeschickt. Du erinnerst dich nicht einmal daran, hier gewesen zu sein.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0r.next": "Antworten",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1r.char": "Du bist ein Ninja.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.3-0r.ancient": "Genug. Lästiger Fehler. Verschwinde.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.3-0r.next": "Antworten",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.3-1r.char": "Du lebst noch.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-attack": "Both",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-attack": "Both",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-attack": "Both",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.3-attack": "Both"
}

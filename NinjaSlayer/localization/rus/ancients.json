{
  "NINJA_SLAYER_EVENT_NANCY_LEE.title": "Нэнси Ли",
  "NINJA_SLAYER_EVENT_NANCY_LEE.epithet": "Старая союзница",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.firstVisitEver.0-0.ancient": "Опоздали на три минуты сорок секунд, Ниндзя Слэйер-сан.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.firstVisitEver.0-0.next": "Ответить",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.firstVisitEver.0-1.char": "По пути были ниндзя.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.firstVisitEver.0-1.next": "Выбрать снаряжение",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.firstVisitEver.0-2.ancient": "Я так и думала. По этому соединению пройдёт один предмет. Выбирайте.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.0-0r.ancient": "Соединение продержится девяносто секунд. Вам — шестьдесят.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.0-0r.next": "Понятно",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.0-1r.char": "А остальные тридцать?",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.0-1r.next": "Выбрать снаряжение",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.0-2r.ancient": "Мне на отход. Выбирайте.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.1-0r.ancient": "Один признак жизни в проходе справа.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.1-0r.next": "Продолжить путь",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.1-1r.char": "Ниндзя.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.1-1r.next": "Выбрать снаряжение",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.1-2r.ancient": "Разумеется. Снаряжение под рукой.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.pages.DONE.description": "",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "[sine]...одно... тело.... два... голоса.... что... ты такое...?[/sine]",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Поздороваться",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Домо, Ньяу-сан. Ниндзя Слэйер дэсу. Вы ниндзя?",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Продолжить",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "[sine]...нет.... ниндзя... есть... наверху.... иди....[/sine]",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "[sine]...я снова... вернула тебя.... проснись.... поднимайся....[/sine]",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "[sine]...ты... убил его.... он снова... жив....[/sine]",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Ответить",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Тогда я убью его снова.",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Принять",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "[sine]...иди....[/sine]",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.char": "Домо, Дарв-сан. Ниндзя Слэйер дэсу.",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Поздороваться",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.ancient": "Жуткое имя, чудесные манеры! Красно-чёрный приятель, в этой куче есть кое-что для тебя!",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Выбрать",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.char": "Достаточно, если убивает ниндзя.",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "Уже сломал прошлое? Бери ещё! Только в меня не бросай!",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "Ты вернулся! Где то, что я тебе дал в прошлый раз?",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Ответить",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Не помню, чтобы я что-то у вас брал.",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Выбрать",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "А? Значит, впервые! Выбирай!",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "Красное и чёрное. Смело, но грубо. Подойди, убийца. Позволь спасти твой наряд.",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Ответить",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Он не должен мешать моему карате.",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Принять",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "Разумеется. Истинное великолепие никогда не уступает силе.",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "Мой красно-чёрный воин. Наконец ты возвращаешься к моему изысканному вкусу.",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "Всё тот же наряд. Раздражающее упрямство. Хоть верность есть.",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Ответить",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Его достаточно.",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Принять",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "«Достаточно» — удел посредственностей. Подойди, мой воин.",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "Красное и чёрное! Жажда крови! Два голоса?! Почему? Кто там ещё?!",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Ответить",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Сначала ответьте. Вы ниндзя?",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Взять",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "Нет! Никаких драк! Возьми что-нибудь блестящее и успокойся!!",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "Снова вернулся?! Всё ещё два голоса! И все руки на месте! Хорошо! Бери что-нибудь, никаких драк!!",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "Всё ещё такой злой! Откуда каждый раз столько жажды крови?!",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Ответить",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Наверху ещё есть ниндзя.",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Взять",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "Здесь нет! Это самое блестящее. Бери и уходи!!",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "[thinky_dots]Так устал... но твой гнев не уснёт.[/thinky_dots]",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Ответить",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Никакого отдыха, пока дело не завершено.",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Принять дар",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "[thinky_dots]Тогда пусть моя плоть примет часть ноши...[/thinky_dots]",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "[i][font_size=22]Паэль неподвижно лежит, свернувшись клубком. По комнате разносится протяжный храп.[/font_size][/i]",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "[thinky_dots]Каждый раз... те же два имени в твоём сердце...[/thinky_dots]",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Ответить",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Не произносите их.",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Принять дар",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "[thinky_dots]Не буду... возьми часть меня и иди дальше...[/thinky_dots]",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "[b]Красно-чёрный воин! Где твоё оружие!?[/b]",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Ответить",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Сначала ответьте. Вы ниндзя?",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Выбрать оружие",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "[b]Нет! Я — Король Химер!! Возьми оружие и сразись со мной!![/b]",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "[b]Ниндзя Слэйер! Снова вернулся!! Покажи своё карате!![/b]",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "[b]Ниндзя Слэйер! Сразись со мной!![/b]",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Сразиться",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "[i][font_size=22]Ниндзя Слэйер обменивается ударами с Танксом.[/font_size][/i]",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Выбрать оружие",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "[b]Прекрасное карате!! Возьми оружие! Мы ещё сразимся!![/b]",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "О, дорогой. Этот огонь всё кусает тебя. Научить его хорошим манерам?",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Предостеречь",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Не трогайте его.",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Принять",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "Какой [jitter][b]эгоистичный[/b][/jitter] ребёнок. Тогда сперва позабочусь о тебе.",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "С возвращением, дорогой. Какой изъян выжжем сегодня?",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "Архитектор ещё жив? Как невежливо заставлять гостя ждать.",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Ответить",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Ненадолго.",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Принять",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "Тогда поешь перед уходом, дорогой.",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "Твой гость проснулся. Пусть и он услышит мои условия.",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Предостеречь",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Не обращайтесь к нему. Вы ниндзя?",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Прочитать договор",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "Нет. Я лишь умею находить согласную сторону.",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "В прошлый раз ты отказал от имени этого тела. Откажешь снова?",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "Я могу навсегда заглушить этот голос. В оплату — лишь это тело.",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Отказать",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Это тело не ваше.",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Прочитать договор",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "Возможно, оно и не только твоё. Для подобных споров и нужны договоры.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0r.ancient": "Вернись к подножию Шпиля.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0r.next": "Отказать",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1r.char": "Отказываюсь.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "Невозможно. Тебя отправили к подножию.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.next": "Ответить",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-1r.char": "И всё же я здесь.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0r.ancient": "Ньяу отправила тебя назад. Ты даже не помнишь, что был здесь.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0r.next": "Ответить",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1r.char": "Ты ниндзя.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.3-0r.ancient": "Хватит. Раздражающая ошибка. Исчезни.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.3-0r.next": "Ответить",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.3-1r.char": "Ты ещё жив.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-attack": "Both",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-attack": "Both",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-attack": "Both",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.3-attack": "Both"
}

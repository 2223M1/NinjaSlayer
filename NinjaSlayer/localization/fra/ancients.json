{
  "NINJA_SLAYER_EVENT_NANCY_LEE.title": "Nancy Lee",
  "NINJA_SLAYER_EVENT_NANCY_LEE.epithet": "Vieille alliée",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.firstVisitEver.0-0.ancient": "Trois minutes et quarante secondes de retard, Ninja Slayer-san.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.firstVisitEver.0-0.next": "Répondre",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.firstVisitEver.0-1.char": "Il y avait des ninjas sur le chemin.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.firstVisitEver.0-1.next": "Choisir l’équipement",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.firstVisitEver.0-2.ancient": "Je m’en doutais. Cette connexion peut transférer un objet. Choisis.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.0-0r.ancient": "Il reste quatre-vingt-dix secondes de connexion. Tu en as soixante.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.0-0r.next": "Compris",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.0-1r.char": "Et les trente autres ?",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.0-1r.next": "Choisir l’équipement",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.0-2r.ancient": "Pour que je sorte. Choisis.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.1-0r.ancient": "Un signe de vie dans le passage à ta droite.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.1-0r.next": "Avancer",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.1-1r.char": "Un ninja.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.1-1r.next": "Choisir l’équipement",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.1-2r.ancient": "Bien sûr. Ton équipement est à portée de main.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.pages.DONE.description": "",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "[sine]...un... corps.... deux... voix.... qu’es... tu...?[/sine]",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Saluer",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Domo, Neow-san. Ninja Slayer desu. Es-tu un ninja ?",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Continuer",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "[sine]...non.... il y a... des ninjas... là-haut.... va....[/sine]",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "[sine]...je t’ai... ramené encore.... réveille-toi.... monte....[/sine]",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "[sine]...tu... l’as tué.... il vit... à nouveau....[/sine]",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Répondre",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Alors je le tuerai encore.",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Accepter",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "[sine]...va....[/sine]",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.char": "Domo, Darv-san. Ninja Slayer desu.",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Saluer",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.ancient": "Quel nom effrayant, quelles jolies manières ! Mon ami rouge et noir, j’ai quelque chose pour toi dans ce tas !",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Choisir",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.char": "Cela suffit, si ça tue les ninjas.",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "Déjà cassé le dernier ? Prends-en un autre ! Ne me le lance pas dessus !",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "Tu es de retour ! Où est le dernier que je t’ai donné ?",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Répondre",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Je ne me souviens pas avoir pris quoi que ce soit de toi.",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Choisir",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "Hein ? Une première fois, alors ! Choisis quelque chose !",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "Rouge et noir. Audacieux, mais grossier. Viens, assassin. Laisse-moi sauver ta tenue.",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Répondre",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Il ne doit pas gêner mon karaté.",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Accepter",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "Naturellement. La vraie splendeur ne cède jamais à la force.",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "Mon guerrier rouge et noir. Enfin, tu reviens à mon bon goût.",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "Toujours cette tenue. Une obstination agaçante. Fidèle, au moins.",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Répondre",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Il suffit.",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Accepter",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "« Suffisant », c’est pour les médiocres. Viens, mon guerrier.",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "Rouge et noir ! Soif de sang ! Deux voix ?! Pourquoi ? Qui d’autre est là-dedans ?!",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Répondre",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Réponds-moi d’abord. Es-tu un ninja ?",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Prendre",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "Non ! Pas de bagarre ! Prends quelque chose qui brille et calme-toi !!",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "Encore de retour ?! Toujours deux voix ! Tous tes bras aussi ! Bien ! Prends quelque chose, pas de bagarre !!",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "Toujours aussi furieux ! Pourquoi cette soif de sang à chaque fois ?!",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Répondre",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Il reste des ninjas là-haut.",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Prendre",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "Pas ici ! Celui-ci brille le plus. Prends-le et pars !!",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "[thinky_dots]Si fatigué... mais ta colère ne dort pas.[/thinky_dots]",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Répondre",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Pas de repos avant d’avoir accompli ma tâche.",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Accepter le cadeau",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "[thinky_dots]Alors laisse ma chair en porter un peu...[/thinky_dots]",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "[i][font_size=22]Pael est recroquevillé, immobile. Un long ronflement résonne dans la pièce.[/font_size][/i]",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "[thinky_dots]À chaque visite... les deux mêmes noms dans ton cœur...[/thinky_dots]",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Répondre",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Ne les prononce pas.",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Accepter le cadeau",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "[thinky_dots]Je ne le ferai pas... prends une part de moi et continue...[/thinky_dots]",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "[b]Guerrier rouge et noir ! Où est ton arme !?[/b]",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Répondre",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Réponds-moi d’abord. Es-tu un ninja ?",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Choisir une arme",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "[b]Non ! Je suis le Roi Chimère !! Prends une arme et affronte-moi !![/b]",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "[b]Ninja Slayer ! Encore de retour !! Montre-moi ton karaté !![/b]",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "[b]Ninja Slayer ! Affronte-moi !![/b]",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Combattre",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "[i][font_size=22]Ninja Slayer échange des coups avec Tanx.[/font_size][/i]",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Choisir une arme",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "[b]Un beau karaté !! Prends une arme ! Nous nous affronterons encore !![/b]",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "Oh, mon chéri. Ce feu n’arrête pas de te mordre. Je lui apprends les bonnes manières ?",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Avertir",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "N’y touche pas.",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Accepter",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "Quel enfant [jitter][b]égoïste[/b][/jitter]. Alors je vais d’abord m’occuper de toi.",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "Bon retour, mon chéri. Quel défaut allons-nous brûler aujourd’hui ?",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "L’Architecte est encore en vie ? Que c’est impoli de faire attendre un invité.",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Répondre",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Plus pour longtemps.",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Accepter",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "Alors mange avant de partir, mon chéri.",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "Ton invité est réveillé. Qu’il entende aussi mes conditions.",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Avertir",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Ne l’appelle pas. Es-tu un ninja ?",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Lire le contrat",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "Non. Je sais simplement trouver une partie consentante.",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "La dernière fois, tu as refusé au nom de ce corps. Le feras-tu encore ?",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "Je peux faire taire cette voix pour toujours. Ce corps pour seul paiement.",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Refuser",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Ce corps n’est pas à toi.",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Lire le contrat",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "Il n’est peut-être pas à toi seul non plus. Les contrats servent à régler ce genre de différends.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0r.ancient": "Retourne au pied de la Tour.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0r.next": "Refuser",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1r.char": "Je refuse.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "Impossible. Tu as été renvoyé tout en bas.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.next": "Répondre",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-1r.char": "Et pourtant, me voici.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0r.ancient": "Neow t’a renvoyé. Tu ne te souviens même pas être venu ici.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0r.next": "Répondre",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1r.char": "Tu es un ninja.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.3-0r.ancient": "Assez. Erreur irritante. Disparais.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.3-0r.next": "Répondre",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.3-1r.char": "Tu vis encore.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-attack": "Both",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-attack": "Both",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-attack": "Both",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.3-attack": "Both"
}

{
  "NINJA_SLAYER_EVENT_NANCY_LEE.title": "Nancy Lee",
  "NINJA_SLAYER_EVENT_NANCY_LEE.epithet": "Vecchia alleata",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.firstVisitEver.0-0.ancient": "Tre minuti e quaranta secondi di ritardo, Ninja Slayer-san.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.firstVisitEver.0-0.next": "Rispondi",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.firstVisitEver.0-1.char": "C’erano ninja lungo la strada.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.firstVisitEver.0-1.next": "Scegli equipaggiamento",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.firstVisitEver.0-2.ancient": "Lo immaginavo. Questa connessione può trasferire un solo oggetto. Scegli.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.0-0r.ancient": "Restano novanta secondi di connessione. A te ne spettano sessanta.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.0-0r.next": "Capito",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.0-1r.char": "E gli altri trenta?",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.0-1r.next": "Scegli equipaggiamento",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.0-2r.ancient": "Per uscire io. Scegli.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.1-0r.ancient": "Un segnale vitale nel passaggio alla tua destra.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.1-0r.next": "Procedi",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.1-1r.char": "Un ninja.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.1-1r.next": "Scegli equipaggiamento",
  "NINJA_SLAYER_EVENT_NANCY_LEE.talk.ANY.1-2r.ancient": "Naturalmente. Il tuo equipaggiamento è a portata di mano.",
  "NINJA_SLAYER_EVENT_NANCY_LEE.pages.DONE.description": "",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "[sine]...un... corpo.... due... voci.... cosa... sei...?[/sine]",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Saluta",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Domo, Neow-san. Ninja Slayer desu. Sei un ninja?",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Continua",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "[sine]...no.... ci sono... ninja... lassù.... vai....[/sine]",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "[sine]...ti ho... riportato indietro.... svegliati.... sali....[/sine]",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "[sine]...tu... l’hai ucciso.... vive... di nuovo....[/sine]",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Rispondi",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Allora lo ucciderò di nuovo.",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Accetta",
  "NEOW.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "[sine]...vai....[/sine]",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.char": "Domo, Darv-san. Ninja Slayer desu.",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Saluta",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.ancient": "Nome spaventoso, modi deliziosi! Amico rosso e nero, ho qualcosa per te in questo mucchio!",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Scegli",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.char": "Basta che uccida i ninja.",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "Hai già rotto l’ultimo? Prendine un altro! Basta che non me lo tiri addosso!",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "Sei tornato! Dov’è l’ultimo che ti ho dato?",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Rispondi",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Non ricordo di aver preso nulla da te.",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Scegli",
  "DARV.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "Eh? Allora è la prima volta! Scegli qualcosa!",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "Rosso e nero. Audace, ma rozzo. Vieni, assassino. Lascia che salvi il tuo abbigliamento.",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Rispondi",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Non deve ostacolare il mio karate.",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Accetta",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "Naturalmente. Il vero splendore non cede mai alla forza.",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "Mio guerriero rosso e nero. Finalmente ritorni al mio buon gusto.",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "Ancora quell’abito. Una testardaggine irritante. Almeno sei fedele.",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Rispondi",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "È sufficiente.",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Accetta",
  "NONUPEIPE.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "«Sufficiente» è per i mediocri. Vieni, mio guerriero.",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "Rosso e nero! Sete di sangue! Due voci?! Perché? Chi altro c’è lì dentro?!",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Rispondi",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Rispondimi prima. Sei un ninja?",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Prendi",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "No! Niente lotte! Prendi qualcosa che luccica e calmati!!",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "Di nuovo qui?! Sempre due voci! E anche tutte le braccia! Bene! Prendi qualcosa, niente lotte!!",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "Sempre così arrabbiato! Perché tutta questa sete di sangue ogni volta?!",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Rispondi",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Ci sono ancora ninja lassù.",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Prendi",
  "OROBAS.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "Non qui! Questo luccica più di tutti. Prendilo e vai!!",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "[thinky_dots]Così stanco... ma la tua rabbia non dorme.[/thinky_dots]",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Rispondi",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Nessun riposo finché non avrò compiuto il mio dovere.",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Accetta il dono",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "[thinky_dots]Allora lascia che la mia carne ne porti un po’...[/thinky_dots]",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "[i][font_size=22]Pael giace rannicchiato, immobile. Un lungo russare rimbomba nella stanza.[/font_size][/i]",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "[thinky_dots]A ogni visita... gli stessi due nomi nel tuo cuore...[/thinky_dots]",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Rispondi",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Non pronunciarli.",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Accetta il dono",
  "PAEL.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "[thinky_dots]Non lo farò... prendi una parte di me e prosegui...[/thinky_dots]",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "[b]Guerriero rosso e nero! Dov’è la tua arma!?[/b]",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Rispondi",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Rispondimi prima. Sei un ninja?",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Scegli un’arma",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "[b]No! Sono il Re Chimera!! Prendi un’arma e affrontami!![/b]",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "[b]Ninja Slayer! Di nuovo qui!! Mostrami il tuo karate!![/b]",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "[b]Ninja Slayer! Affrontami!![/b]",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Combatti",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "[i][font_size=22]Ninja Slayer scambia colpi con Tanx.[/font_size][/i]",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Scegli un’arma",
  "TANX.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "[b]Ottimo karate!! Prendi un’arma! Ci affronteremo ancora!![/b]",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "Oh, caro. Quel fuoco continua a morderti. Gli insegno le buone maniere?",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Avverti",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Non toccarlo.",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Accetta",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "Che bambino [jitter][b]egoista[/b][/jitter]. Allora prima mi occuperò di te.",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "Bentornato, caro. Quale difetto bruceremo oggi?",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "L’Architetto è ancora vivo? Che maleducazione far aspettare un ospite.",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Rispondi",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Non per molto.",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Accetta",
  "TEZCATARA.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "Allora mangia prima di andare, caro.",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.ancient": "Il tuo ospite è sveglio. Lascia che ascolti anche lui le mie condizioni.",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0.next": "Avverti",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.char": "Non chiamarlo. Sei un ninja?",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1.next": "Leggi il contratto",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-2.ancient": "No. So soltanto come trovare una parte consenziente.",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "L’ultima volta hai rifiutato per conto di questo corpo. Lo farai ancora?",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.ancient": "Posso far tacere quella voce per sempre. Solo questo corpo come pagamento.",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0.next": "Rifiuta",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.char": "Questo corpo non è tuo.",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1.next": "Leggi il contratto",
  "VAKUU.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-2.ancient": "Forse non è neanche soltanto tuo. I contratti servono a risolvere queste dispute.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0r.ancient": "Torna ai piedi della Guglia.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-0r.next": "Rifiuta",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-1r.char": "Mi rifiuto.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.ancient": "Impossibile. Sei stato rimandato in fondo.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-0r.next": "Rispondi",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-1r.char": "Eppure sono qui.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0r.ancient": "Neow ti ha rimandato indietro. Non ricordi neanche di essere stato qui.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-0r.next": "Rispondi",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-1r.char": "Sei un ninja.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.3-0r.ancient": "Basta. Errore irritante. Sparisci.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.3-0r.next": "Rispondi",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.3-1r.char": "Sei ancora vivo.",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.0-attack": "Both",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.1-attack": "Both",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.2-attack": "Both",
  "THE_ARCHITECT.talk.NINJA_SLAYER_CHARACTER_NINJA_SLAYER_CHARACTER.3-attack": "Both"
}
